# Create a bot with @BotFather in Telegram. Keep its token private.
TELEGRAM_BOT_TOKEN=
# Send your bot /start, then run: uv run vitool --telegram-chats
TELEGRAM_CHAT_ID=
# Optional: free Gemini key from https://aistudio.google.com/apikey for AI review of matches
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Optional: persistent directory for settings and history
# VITOOL_DATA_DIR=./data

# Cloud deployment only. Keep tokens and passwords private.
# TURSO_DATABASE_URL=libsql://database-account.region.turso.io
# TURSO_AUTH_TOKEN=
